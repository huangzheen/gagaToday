# Docker build 排除 — 避免 node_modules / .venv / .git 等进镜像
# 文件路径: 项目根 /Volumes/NewDisk/GermanLearning/.dockerignore

# ── VCS ──
.git
.gitignore
.gitattributes

# ── Python ──
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
backend/conftest.py
backend/game_data.db
backend/game_data.db-shm
backend/game_data.db-wal
**/tests
**/test_*.py

# ── Node ──
**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# ── 构建产物(各前端会自己 npm run build,不需要预存的 dist) ──
**/dist
**/dist-ssr
**/*.local

# ── 测试 / IDE ──
.vscode
.idea
.DS_Store
*.swp
*.swo
*~
coverage
.nyc_output

# ── 大资源 / runtime(用 volume 挂,不进镜像) ──
assets
docs
runtime
tmp
logs
*.log
tests-output

# ── 部署自身的产物(避免递归) ──
.deploy

# ── Misc ──
*.md
!backend/poi-generator/README.md
scripts