# gagaToday 部署环境变量模板
# 复制: cp deploy/.env.example deploy/.env
# 然后填实际值(vault 已经存了,这里只是把变量名钉在 compose 里)

# ── API keys ──
# 从 /Volumes/NewDisk/.agent-secrets/secrets.env 拷过来
# (生产容器里走 env_file 直接 source,这里列的只是 compose 引用)

# DashScope(Qwen LLM,这个项目固定用这个 key)
DASHSCOPE_API_KEY=sk-placeholder-replace-with-vault-value

# DeepSeek(V4 系列,GermanLearning 项目专属 key)
GERMANLEARNING_DEEPSEEK_API_KEY=sk-placeholder-replace-with-vault-value

# Brave Search(Wikipedia fallback)
BRAVE_API_KEY=BSAG-placeholder-replace-with-vault-value