// ── gagaToday Game Client · 非敏感运行时配置 ──
// 真实密钥只放 /Volumes/NewDisk/.agent-secrets/secrets.env,绝不入仓。

# 真实地图数据(PMTiles)
VITE_PMTILES_URL=http://127.0.0.1:8081/assets/munich_map/pmtiles/germany-zoom16.pmtiles

# Game API (只读运行时)
VITE_GAME_API_URL=http://127.0.0.1:8000

# Bundle 版本(可选,留空则永远拿最新)
VITE_BUNDLE_CONTENT_VERSION=